@model PaternosterDemo.Models.Bin

<h2>Delete Bin</h2>
<p>Are you sure you want to delete this bin?</p>
<p>BinId: @Model.BinId, Shelf: @Model.Shelf?.ShelfId, Part: @Model.Part?.Name, Quantity: @Model.Quantity</p>

<form asp-action="Delete">
    <input type="hidden" asp-for="BinId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
