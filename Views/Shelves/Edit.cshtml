@model PaternosterDemo.Models.Shelf

@{
    ViewData["Title"] = "Edit Shelf";
}

<h1>Edit Shelf</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ShelfId" />

    <div class="mb-3">
        <label asp-for="CabinetId" class="form-label">Cabinet</label>
        <select asp-for="CabinetId" class="form-select" asp-items="@(new SelectList(ViewData["Cabinets"] as List<PaternosterDemo.Models.Cabinet>, "CabinetId", "Name", Model.CabinetId))">
            <option value="">-- Select Cabinet --</option>
        </select>
        <span asp-validation-for="CabinetId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaxBins" class="form-label"></label>
        <input asp-for="MaxBins" class="form-control" />
        <span asp-validation-for="MaxBins" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
