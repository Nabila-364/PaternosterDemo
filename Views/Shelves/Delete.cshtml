@model PaternosterDemo.Models.Shelf

@{
    ViewData["Title"] = "Delete Shelf";
}

<h1>Delete Shelf</h1>

<h3>Are you sure you want to delete this shelf?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Shelf Id</dt>
        <dd class="col-sm-10">@Model.ShelfId</dd>

        <dt class="col-sm-2">Cabinet</dt>
        <dd class="col-sm-10">@Model.Cabinet?.Name</dd>

        <dt class="col-sm-2">Max Bins</dt>
        <dd class="col-sm-10">@Model.MaxBins</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ShelfId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
