@model PaternosterDemo.Models.Shelf

@{
    ViewData["Title"] = "Shelf Details";
}

<h1>Details</h1>

<div>
    <h4>Shelf</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Shelf Id</dt>
        <dd class="col-sm-10">@Model.ShelfId</dd>

        <dt class="col-sm-2">Cabinet</dt>
        <dd class="col-sm-10">@Model.Cabinet?.Name</dd>

        <dt class="col-sm-2">Max Bins</dt>
        <dd class="col-sm-10">@Model.MaxBins</dd>
    </dl>
</div>

<p>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ShelfId">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</p>
