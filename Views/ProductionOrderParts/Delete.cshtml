@model PaternosterDemo.Models.ProductionOrderPart

@{
    ViewData["Title"] = "Delete Production Order Part";
}

<h2>Delete</h2>

<dl class="row">
    <dt class="col-sm-2">Order ID</dt>
    <dd class="col-sm-10">@Model.ProductionOrderId</dd>

    <dt class="col-sm-2">Part</dt>
    <dd class="col-sm-10">@Model.Part?.Name</dd>

    <dt class="col-sm-2">Quantity</dt>
    <dd class="col-sm-10">@Model.Quantity</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ProductionOrderPartId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
