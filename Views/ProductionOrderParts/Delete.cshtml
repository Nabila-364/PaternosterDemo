@model PaternosterDemo.Models.ProductionOrderPart

@{
    ViewData["Title"] = "Delete Production Order Part";
}

<h1>Delete Production Order Part</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Part Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Part</dt>
        <dd class="col-sm-10">@Model.Part?.Name</dd>

        <dt class="col-sm-2">Order ID</dt>
        <dd class="col-sm-10">@Model.ProductionOrder?.OrderId</dd>

        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
