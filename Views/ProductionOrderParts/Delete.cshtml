@model PaternosterDemo.Models.ProductionOrderPart

@{
    ViewData["Title"] = "Verwijder Productie Order Onderdeel";
}

<h2>@ViewData["Title"]</h2>

<div class="alert alert-warning">
    Weet je zeker dat je dit onderdeel wilt verwijderen?
</div>

<div class="mb-3">
    <strong>Order Id:</strong> @Model.ProductionOrderOrderId
</div>
<div class="mb-3">
    <strong>Onderdeel:</strong> @Model.Part?.Name
</div>
<div class="mb-3">
    <strong>Aantal:</strong> @Model.Quantity
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Verwijderen</button>
    <a asp-action="Index" class="btn btn-secondary">Annuleren</a>
</form>
