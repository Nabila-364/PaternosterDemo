@model PaternosterDemo.Models.ProductionOrderPart

@{
    ViewData["Title"] = "Add Part to Production Order";
    var parts = ViewData["Parts"] as List<PaternosterDemo.Models.Part>;
    var orders = ViewData["Orders"] as List<PaternosterDemo.Models.ProductionOrder>;
}

<h1>Add Part to Production Order</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="PartId" class="form-label">Part</label>
        <select asp-for="PartId" class="form-select" asp-items="@(new SelectList(parts, "PartId", "Name"))">
            <option value="">-- Select Part --</option>
        </select>
        <span asp-validation-for="PartId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductionOrderOrderId" class="form-label">Order</label>
        <select asp-for="ProductionOrderOrderId" class="form-select" asp-items="@(new SelectList(orders, "OrderId", "OrderId"))">
            <option value="">-- Select Order --</option>
        </select>
        <span asp-validation-for="ProductionOrderOrderId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
