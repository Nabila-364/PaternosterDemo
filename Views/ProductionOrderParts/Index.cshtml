@model IEnumerable<PaternosterDemo.Models.ProductionOrderPart>

@{
    ViewData["Title"] = "Production Order Parts";
}

<h1>Production Order Parts</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nieuwe Productieorder Part</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Part</th>
            <th>Quantity</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductionOrderId</td>
                <td>@item.Part?.Name</td>
                <td>@item.Quantity</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ProductionOrderPartId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@item.ProductionOrderPartId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.ProductionOrderPartId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
