@model IEnumerable<PaternosterDemo.Models.ProductionOrderPart>

@{
    ViewData["Title"] = "Productie Order Onderdelen";
}

<h2>@ViewData["Title"]</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Nieuw onderdeel toevoegen</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order Id</th>
            <th>Onderdeel</th>
            <th>Aantal</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductionOrderOrderId</td>
                <td>@item.Part?.Name</td>
                <td>@item.Quantity</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@item.Id">Bewerken</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Verwijderen</a>
                </td>
            </tr>
        }
    </tbody>
</table>
