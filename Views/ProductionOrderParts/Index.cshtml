@model IEnumerable<PaternosterDemo.Models.ProductionOrderPart>

@{
    ViewData["Title"] = "Production Order Parts";
}

<h1>Production Order Parts</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Add New Part to Order</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Part</th>
            <th>Order</th>
            <th>Quantity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Part?.Name</td>
                <td>@item.ProductionOrder?.OrderId</td>
                <td>@item.Quantity</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
