@model PaternosterDemo.Models.ProductionOrderPart

@{
    ViewData["Title"] = "Details Productie Order Onderdeel";
}

<h2>@ViewData["Title"]</h2>

<div class="mb-3">
    <strong>Order Id:</strong> @Model.ProductionOrderOrderId
</div>
<div class="mb-3">
    <strong>Onderdeel:</strong> @Model.Part?.Name
</div>
<div class="mb-3">
    <strong>Aantal:</strong> @Model.Quantity
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info">Bewerken</a>
<a asp-action="Index" class="btn btn-secondary">Terug</a>
