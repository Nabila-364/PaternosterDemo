@model PaternosterDemo.Models.ProductionOrderPart

@{
    ViewData["Title"] = "Edit Production Order Part";
}

<h2>Edit Production Order Part</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ProductionOrderPartId" />

    <div class="mb-3">
        <label asp-for="ProductionOrderId" class="form-label"></label>
        <select asp-for="ProductionOrderId" class="form-select"
                asp-items="@(new SelectList(ViewData["Orders"] as List<PaternosterDemo.Models.ProductionOrder>, "ProductionOrderId", "ProductionOrderId"))">
            <option value="">-- Select Order --</option>
        </select>
        <span asp-validation-for="ProductionOrderId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PartId" class="form-label"></label>
        <select asp-for="PartId" class="form-select"
                asp-items="@(new SelectList(ViewData["Parts"] as List<PaternosterDemo.Models.Part>, "PartId", "Name"))">
            <option value="">-- Select Part --</option>
        </select>
        <span asp-validation-for="PartId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Opslaan</button>
    <a asp-action="Index" class="btn btn-secondary">Annuleren</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
