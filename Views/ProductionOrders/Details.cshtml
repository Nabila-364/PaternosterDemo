@model PaternosterDemo.Models.ProductionOrder

@{
    ViewData["Title"] = "Details Productieorder";
}

<h2>Details Productieorder</h2>

<div>
    <h4>Order</h4>
    <dl class="row">
        <dt class="col-sm-2">Order ID</dt>
        <dd class="col-sm-10">@Model.ProductionOrderId</dd>

        <dt class="col-sm-2">Date</dt>
        <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
</div>

<h4>Onderdelen</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Part</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var part in Model.ProductionOrderParts)
        {
            <tr>
                <td>@part.Part?.Name</td>
                <td>@part.Quantity</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Terug</a>
