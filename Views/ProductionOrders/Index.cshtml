@model IEnumerable<PaternosterDemo.Models.ProductionOrder>

@{
    ViewData["Title"] = "Productieorders";
}

<h1>Productieorders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nieuwe Productieorder</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Date</th>
            <th>Status</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.ProductionOrderId</td>
                <td>@order.Date.ToShortDateString()</td>
                <td>@order.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.ProductionOrderId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@order.ProductionOrderId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@order.ProductionOrderId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
