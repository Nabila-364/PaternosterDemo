@model IEnumerable<PaternosterDemo.Models.ProductionOrder>
@{
    ViewData["Title"] = "Productieorders";
}

<h2>Productieorders</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Nieuwe Order</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>OrderId</th>
            <th>Date</th>
            <th>Status</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.Date.ToString("dd/MM/yyyy")</td>
                <td>@order.Status</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@order.OrderId">Details</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@order.OrderId">Bewerk</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@order.OrderId">Verwijder</a>
                </td>
            </tr>
        }
    </tbody>
</table>
