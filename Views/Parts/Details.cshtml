@model PaternosterDemo.Models.Part

@{
    ViewData["Title"] = "Part Details";
}

<h2>Part Details</h2>

<div>
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Part Number</dt>
        <dd class="col-sm-10">@Model.ArticleNumber</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        <dt class="col-sm-2">Minimum Stock</dt>
        <dd class="col-sm-10">@Model.MinimumStock</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.PartId" class="btn btn-primary">Edit</a> |
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
