@model PaternosterDemo.Models.Cabinet

@{
    ViewData["Title"] = "Cabinet Details";
}

<h1>Cabinet Details</h1>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Location</dt>
    <dd class="col-sm-10">@Model.Location</dd>

    <dt class="col-sm-2">Capacity</dt>
    <dd class="col-sm-10">@Model.Capacity</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.CabinetId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
