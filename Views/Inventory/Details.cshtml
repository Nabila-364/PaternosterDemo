@model PaternosterDemo.Models.Inventory

@{
    ViewData["Title"] = "Inventory Details";
}

<h1>Inventory Details</h1>

<dl class="row">
    <dt class="col-sm-2">Part</dt>
    <dd class="col-sm-10">@Model.Part?.Name</dd>

    <dt class="col-sm-2">Cabinet</dt>
    <dd class="col-sm-10">@Model.Cabinet?.Name</dd>

    <dt class="col-sm-2">Quantity</dt>
    <dd class="col-sm-10">@Model.Quantity</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.InventoryId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
